# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Optional: without this key Sentinel uses the grounded-rules analyzer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional backup when Groq is unavailable or returns an invalid response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: without this key Sentinel uses in-process memory.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=acme-sre
HINDSIGHT_MENTAL_MODEL_ID=checkout-redis-pattern

DATABASE_URL=sqlite:///./backend/sentinel.db
CORS_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=30
